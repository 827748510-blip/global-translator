{
  "manifest_version": 3,
  "name": "Global Translator Bridge",
  "version": "1.0.4",
  "description": "网页整页原地翻译，配合 macOS 菜单栏的 Global Translator 使用。",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:9233/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Global Translator"
  }
}
