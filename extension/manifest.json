{
  "manifest_version": 3,
  "name": "Global Translator Bridge",
  "version": "1.0.9",
  "description": "网页整页原地翻译，并可选用视频字幕叠中文。配合 macOS 菜单栏的 Global Translator 使用。",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:9233/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtube-nocookie.com/*"
      ],
      "js": ["youtube-captions-page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["text-filter.js", "subtitle-cues.js", "youtube-captions.js", "content.js", "video-translate.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Global Translator"
  }
}
